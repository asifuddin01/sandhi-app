{
  "expo": {
    "name": "SANDHI",
    "slug": "sandhi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sandhi",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141a2e",
    "ios": {
      "bundleIdentifier": "org.sandhiresearch.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "org.sandhiresearch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141a2e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141a2e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "sandhi-research-lab"
  }
}
